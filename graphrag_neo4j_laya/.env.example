# ── Decision Model Backend ────────────────────────────────────────────────────
# Options: laya | jev | ablation
#   laya     → Local Convai model (~33ms, ~1.2GB VRAM, 100% private, no cost)
#   jev      → TypeSafe Jev cloud API (~70-500ms, $0.042/M tokens, zero-shot ready)
#   ablation → Runs BOTH in parallel, logs comparison to benchmarks/results/ablation_log.jsonl
DECISION_MODEL_BACKEND=laya

# In ablation mode, which backend score drives the live A* traversal?
DECISION_MODEL_PRIMARY=laya

# ── Jev API (TypeSafe) ─────────────────────────────────────────────────────────
# Only required if DECISION_MODEL_BACKEND=jev or ablation
# Get your key at: https://typesafe.ai
JEV_API_KEY=
JEV_TIMEOUT_SECONDS=10
JEV_FALLBACK_SCORE=0.5    # score returned if Jev API is unavailable (prevents traversal crash)
ABLATION_LOG_PATH=benchmarks/results/ablation_log.jsonl

# ── Graph Database Selection ──────────────────────────────────────────────────
# Options: neo4j | postgres_age | memgraph | kuzu
GRAPH_DB_TYPE=neo4j

# ── Neo4j (matches docker-compose.yml defaults) ──────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=testpassword

# ── Memgraph (matches docker-compose.yml defaults) ───────────────────────────
# Memgraph uses the Neo4j config variables above, just on port 7688
# NEO4J_URI=bolt://localhost:7688
# NEO4J_USER=
# NEO4J_PASSWORD=

# ── Apache AGE / Postgres ─────────────────────────────────────────────────────
AGE_HOST=localhost
AGE_PORT=5432
AGE_USER=postgres
AGE_PASSWORD=testpassword
AGE_DATABASE=graph_db

# ── Model IDs (HuggingFace Hub) ───────────────────────────────────────────────
# Laya typed-decisions classifier (Apache 2.0, 421M params, ~1.2 GB VRAM FP16)
LAYA_MODEL_ID=convaiinnovations/laya-typed-decisions

# Pre-quantized Llama-3.1 8B NF4 (no on-the-fly quantization needed)
LLM_MODEL_ID=hugging-quants/Meta-Llama-3.1-8B-Instruct-BNB-NF4

# Sentence-Transformers embedding model for first-pass node retrieval
EMBED_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# HuggingFace token (needed for gated models such as meta-llama/* variants)
HUGGINGFACE_TOKEN=hf_YOUR_TOKEN_HERE

# ── A* Hyperparameters ────────────────────────────────────────────────────────
ALPHA=0.65
BETA=0.25
GAMMA=0.10
MAX_PAGERANK=10.0

# ── Thresholds ────────────────────────────────────────────────────────────────
NOUL_BOUNDARY_THRESHOLD=0.85
ENTITY_COSINE_THRESHOLD=0.85
ENTITY_NOUL_MERGE_THRESHOLD=0.95
BFS_PRUNE_THRESHOLD=0.6
SEED_COLBERT_TOP_N=20
SEED_FINAL_TOP_K=2
